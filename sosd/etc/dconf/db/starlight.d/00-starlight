[org/gnome/desktop/interface]
accent-color='yellow'
color-scheme='prefer-dark'
gtk-theme='Adwaita-dark'
icon-theme='Starlight-Colloid-Yellow-Dark'
monospace-font-name='JetBrainsMono Nerd Font 11'

[org/gnome/desktop/peripherals/keyboard]
# Keep the numeric keypad enabled for the live session and installed users.
numlock-state=true

[org/gnome/desktop/background]
picture-uri='file:///usr/share/backgrounds/starlight/starlight-wallpaper.png'
picture-uri-dark='file:///usr/share/backgrounds/starlight/starlight-wallpaper.png'
picture-options='zoom'

[org/gnome/desktop/screensaver]
picture-uri='file:///usr/share/backgrounds/starlight/starlight-wallpaper.png'
picture-options='zoom'

[org/gnome/desktop/calendar]
show-weekdate=true

[org/gnome/desktop/wm/preferences]
button-layout='appmenu:minimize,maximize,close'

[org/gnome/desktop/default-applications/terminal]
exec='ptyxis'
exec-arg=''

[org/gnome/shell]
disable-user-extensions=false
enabled-extensions=['blur-my-shell@aunetx', 'dash-to-dock@micxgx.gmail.com', 'ubuntu-appindicators@ubuntu.com', 'caffeine@patapon.info', 'tiling-assistant@leleat-on-github', 'monitor-brightness-volume@ailin.nemui', 'kiwimenu@kemma', 'search-light@icedman.github.com', 'starlight-clock-right@starlightbrasil.com']
favorite-apps=['firefox-esr.desktop', 'org.gnome.Nautilus.desktop', 'org.gnome.Ptyxis.desktop', 'org.gnome.Software.desktop', 'io.github.kolunmi.Bazaar.desktop', 'starlight-install.desktop']

[org/gnome/shell/extensions/search-light]
# Search Light's default shortcut is Ctrl+Space.
shortcut-search=['<Control>space']

[org/gnome/shell/extensions/kiwimenu]
# 0 is the extension's first icon slot; the image is replaced during build.
icon=0

# Dash to Dock owns the desktop dock appearance. Keep it as a floating,
# translucent navy surface instead of inheriting the grey upstream fallback.
[org/gnome/shell/extensions/dash-to-dock]
dock-position='BOTTOM'
# Keep the dock permanently visible; users can still change this in Dash to
# Dock preferences if they want an auto-hidden dock.
autohide=false
intellihide=false
dock-fixed=true
extend-height=false
dash-max-icon-size=48
custom-theme-shrink=false
custom-background-color=true
background-color='#07182b'
transparency-mode='FIXED'
background-opacity=0.74
custom-theme-customize-running-dots=true
custom-theme-running-dots-color='#f3c653'
custom-theme-running-dots-border-color='#c89b3c'
running-indicator-style='DASHES'
