#!/usr/bin/python3
"""Graphical apply/rollback front end for the Starlight Fedora profile."""

import os
import pwd
import subprocess
import threading
from pathlib import Path

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("GdkPixbuf", "2.0")
from gi.repository import Gdk, GdkPixbuf, GLib, Gtk  # noqa: E402


STATE_MARKER = Path("/var/lib/starlight-fedora/profile-applied")
PROFILE_VERSION = "10"
SYSTEM_DESKTOP = Path(
    "/usr/share/applications/com.starlight.FedoraManager.desktop"
)
USER_DESKTOP = (
    Path.home()
    / ".local/share/applications/com.starlight.FedoraManager.desktop"
)
ICON_PATH = "/usr/share/pixmaps/starlight-fedora-manager.png"


class ProfileManager(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="com.starlight.FedoraManager")
        self.window = None

    def do_activate(self):
        if self.window is None:
            self.window = ProfileWindow(self)
        self.window.present()


class ProfileWindow(Gtk.ApplicationWindow):
    def __init__(self, application):
        super().__init__(application=application)
        self.set_default_size(620, 520)
        self.set_resizable(True)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_icon_from_file(ICON_PATH)
        self.process = None
        self.connect("delete-event", self.on_delete_event)
        self._build_ui()
        self.show_all()
        self.refresh_state()

    def _build_ui(self):
        css = Gtk.CssProvider()
        css.load_from_data(
            b"""
            .starlight-primary {
                background: #f3c653;
                color: #08111e;
                font-weight: 700;
                border-color: #c89b3c;
            }
            .starlight-danger {
                color: #c01c28;
            }
            """
        )
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(),
            css,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
        )

        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18)
        outer.set_border_width(28)
        self.add(outer)

        logo = Gtk.Image()
        pixbuf = GdkPixbuf.Pixbuf.new_from_file_at_scale(
            ICON_PATH, 112, 112, True
        )
        logo.set_from_pixbuf(pixbuf)
        outer.pack_start(logo, False, False, 0)

        self.heading = Gtk.Label()
        self.heading.set_xalign(0.5)
        self.heading.set_line_wrap(True)
        self.heading.get_style_context().add_class("title")
        outer.pack_start(self.heading, False, False, 0)

        self.description = Gtk.Label()
        self.description.set_xalign(0.5)
        self.description.set_justify(Gtk.Justification.CENTER)
        self.description.set_line_wrap(True)
        self.description.set_max_width_chars(64)
        outer.pack_start(self.description, False, False, 0)

        self.spinner = Gtk.Spinner()
        outer.pack_start(self.spinner, False, False, 0)

        self.log_scroll = Gtk.ScrolledWindow()
        self.log_scroll.set_policy(
            Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC
        )
        self.log_scroll.set_min_content_height(170)
        self.log_view = Gtk.TextView()
        self.log_view.set_editable(False)
        self.log_view.set_cursor_visible(False)
        self.log_view.set_monospace(True)
        self.log_view.set_wrap_mode(Gtk.WrapMode.WORD_CHAR)
        self.log_scroll.add(self.log_view)
        outer.pack_start(self.log_scroll, True, True, 0)

        self.buttons = Gtk.ButtonBox(orientation=Gtk.Orientation.HORIZONTAL)
        self.buttons.set_layout(Gtk.ButtonBoxStyle.CENTER)
        self.buttons.set_spacing(12)
        outer.pack_end(self.buttons, False, False, 0)

        self.primary_button = Gtk.Button()
        self.primary_button.get_style_context().add_class("starlight-primary")
        self.primary_button.connect("clicked", self.on_primary_clicked)
        self.buttons.add(self.primary_button)

        self.purge_button = Gtk.Button(label="Remover também o visual Starlight")
        self.purge_button.get_style_context().add_class("starlight-danger")
        self.purge_button.connect("clicked", self.on_purge_clicked)
        self.buttons.add(self.purge_button)

    @property
    def applied(self):
        return STATE_MARKER.is_file()

    @property
    def profile_current(self):
        try:
            return STATE_MARKER.read_text(encoding="utf-8").strip() == PROFILE_VERSION
        except OSError:
            return False

    def refresh_state(self):
        if self.applied and self.profile_current:
            self.set_title("Remover perfil Starlight")
            self.heading.set_markup(
                "<span size='xx-large' weight='bold'>"
                "Perfil Starlight instalado"
                "</span>"
            )
            self.description.set_text(
                "Os aplicativos e ajustes opcionais estão ativos. "
                "Você pode restaurar os aplicativos anteriores mantendo o "
                "visual, ou remover também o pacote visual Starlight."
            )
            self.primary_button.set_label("Restaurar aplicativos anteriores")
            self.purge_button.show()
            self._write_state_launcher(
                "Remover perfil Starlight",
                "Restaurar aplicativos ou remover o perfil Starlight",
                "remover;restaurar;rollback",
            )
        elif self.applied:
            self.set_title("Atualizar perfil Starlight")
            self.heading.set_markup(
                "<span size='xx-large' weight='bold'>"
                "Atualização do perfil disponível"
                "</span>"
            )
            self.description.set_text(
                "Atualiza o conjunto de aplicativos e conclui os novos "
                "ajustes Starlight sem reinstalar o que já está pronto."
            )
            self.primary_button.set_label("Atualizar perfil Starlight")
            self.purge_button.show()
            self._write_state_launcher(
                "Atualizar perfil Starlight",
                "Instalar as atualizações do perfil Starlight",
                "atualizar;update;aplicar",
            )
        else:
            self.set_title("Instalar perfil Starlight")
            self.heading.set_markup(
                "<span size='xx-large' weight='bold'>"
                "Completar a instalação do Starlight"
                "</span>"
            )
            self.description.set_text(
                "Instala o conjunto de aplicativos, substitui o LibreOffice "
                "pelo WPS Office, configura o Flathub, instala Bazaar, ZapZap "
                "e Telegram e aplica o avatar Starlight ao seu usuário."
            )
            self.primary_button.set_label("Instalar perfil Starlight")
            self.purge_button.hide()
            self._remove_user_launcher()
        self.primary_button.set_sensitive(True)
        self.log_scroll.hide()

    def _write_state_launcher(self, name, comment, keywords):
        if not SYSTEM_DESKTOP.exists():
            return
        try:
            USER_DESKTOP.parent.mkdir(parents=True, exist_ok=True)
            USER_DESKTOP.write_text(
                f"""[Desktop Entry]
Type=Application
Name={name}
Name[pt_BR]={name}
Comment={comment}
Comment[pt_BR]={comment}
Exec=/usr/bin/starlight-fedora-manager
Icon=starlight-fedora-manager
Terminal=false
StartupNotify=true
Categories=Settings;
Keywords=Starlight;{keywords};
""",
                encoding="utf-8",
            )
        except OSError:
            # The stateful action in this window remains usable even when a
            # damaged ~/.local directory prevents changing the menu label.
            pass

    def _remove_user_launcher(self):
        try:
            USER_DESKTOP.unlink()
        except OSError:
            pass

    def on_delete_event(self, _window, _event):
        if self.process is None or self.process.poll() is not None:
            return False
        dialog = Gtk.MessageDialog(
            transient_for=self,
            modal=True,
            message_type=Gtk.MessageType.INFO,
            buttons=Gtk.ButtonsType.OK,
            text="A operação ainda está em andamento",
        )
        dialog.format_secondary_text(
            "Mantenha esta janela aberta até a instalação terminar."
        )
        dialog.run()
        dialog.destroy()
        return True

    def _confirm(self, title, message, destructive=False):
        dialog = Gtk.MessageDialog(
            transient_for=self,
            modal=True,
            message_type=(
                Gtk.MessageType.WARNING
                if destructive
                else Gtk.MessageType.QUESTION
            ),
            buttons=Gtk.ButtonsType.CANCEL,
            text=title,
        )
        dialog.format_secondary_text(message)
        dialog.add_button("Continuar", Gtk.ResponseType.OK)
        response = dialog.run()
        dialog.destroy()
        return response == Gtk.ResponseType.OK

    def on_primary_clicked(self, _button):
        if self.applied and self.profile_current:
            if not self._confirm(
                "Restaurar os aplicativos anteriores?",
                "Os pacotes instalados pelo perfil serão removidos e o "
                "LibreOffice será reinstalado. O tema visual permanecerá.",
            ):
                return
            self._run_privileged(
                ["/usr/bin/starlight-fedora-rollback"],
                "Restaurando aplicativos…",
            )
        else:
            updating = self.applied
            if not self._confirm(
                (
                    "Atualizar o perfil Starlight?"
                    if updating
                    else "Instalar o perfil completo?"
                ),
                "A operação requer internet, pode demorar e substituirá "
                "LibreOffice, Epiphany e Chromium conforme o perfil Starlight.",
            ):
                return
            username = pwd.getpwuid(os.getuid()).pw_name
            self._run_privileged(
                [
                    "/usr/bin/starlight-fedora-apply",
                    "--user",
                    username,
                ],
                "Instalando o perfil…",
            )

    def on_purge_clicked(self, _button):
        if not self._confirm(
            "Remover completamente o Starlight?",
            "Os aplicativos anteriores serão restaurados e o pacote visual "
            "Starlight será removido do Fedora.",
            destructive=True,
        ):
            return
        self._run_privileged(
            [
                "/usr/bin/starlight-fedora-rollback",
                "--purge-assets",
            ],
            "Removendo o Starlight…",
        )

    def _run_privileged(self, command, status):
        self.primary_button.set_sensitive(False)
        self.purge_button.set_sensitive(False)
        self.description.set_text(status)
        self.log_view.get_buffer().set_text("")
        self.log_scroll.show()
        self.spinner.start()

        try:
            self.process = subprocess.Popen(
                ["/usr/bin/pkexec", *command],
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                text=True,
                bufsize=1,
            )
        except OSError as error:
            self._append_log(f"Não foi possível iniciar a operação: {error}\n")
            self._finish_operation(1)
            return

        thread = threading.Thread(target=self._read_process, daemon=True)
        thread.start()

    def _read_process(self):
        assert self.process is not None
        assert self.process.stdout is not None
        for line in self.process.stdout:
            GLib.idle_add(self._append_log, line)
        return_code = self.process.wait()
        GLib.idle_add(self._finish_operation, return_code)

    def _append_log(self, line):
        buffer = self.log_view.get_buffer()
        buffer.insert(buffer.get_end_iter(), line)
        adjustment = self.log_scroll.get_vadjustment()
        GLib.idle_add(adjustment.set_value, adjustment.get_upper())
        return False

    def _finish_operation(self, return_code):
        self.spinner.stop()
        self.process = None
        self.purge_button.set_sensitive(True)
        if return_code == 0:
            self.refresh_state()
            dialog = Gtk.MessageDialog(
                transient_for=self,
                modal=True,
                message_type=Gtk.MessageType.INFO,
                buttons=Gtk.ButtonsType.OK,
                text="Operação concluída",
            )
            dialog.format_secondary_text(
                "Encerre a sessão e entre novamente para atualizar o GNOME."
            )
        else:
            self.primary_button.set_sensitive(True)
            dialog = Gtk.MessageDialog(
                transient_for=self,
                modal=True,
                message_type=Gtk.MessageType.ERROR,
                buttons=Gtk.ButtonsType.OK,
                text=(
                    "Autenticação cancelada"
                    if return_code in (126, 127)
                    else "Não foi possível concluir a operação"
                ),
            )
            dialog.format_secondary_text(
                "Consulte as últimas mensagens exibidas na janela."
            )
        dialog.run()
        dialog.destroy()
        return False


if __name__ == "__main__":
    raise SystemExit(ProfileManager().run())
