#!/usr/bin/env bash
# Apply Starlight's optional Fedora application profile.  Every action is
# recorded so starlight-fedora-rollback can undo only what this command did.
set -Eeuo pipefail

state_dir=/var/lib/starlight-fedora
installed_file="${state_dir}/installed-rpms"
removed_file="${state_dir}/removed-rpms"
flatpak_file="${state_dir}/flatpaks"
profile_marker="${state_dir}/profile-applied"
profile_version=10
skip_flatpaks=false
profile_user=
wps_version=12.1.2.26885.AK.preread.sw
wps_rpm_name=wps-office-12.1.2.26885.AK.preread.sw.Personal-1-715973.x86_64.rpm
wps_rpm_path="/wps/download/ep/Linux2023/26885/${wps_rpm_name}"
wps_rpm_sha256=d98376b062afd6bc270872fce67f09d96735b88f4efe8eb2e45f51bde1c47595
wps_download_key=7f8faaaa468174dc1c9cd62e5f218a5b

usage() {
    cat <<'EOF'
Usage: starlight-fedora-apply [--skip-flatpaks] [--user LOCAL_USER]

Installs the Fedora-mapped Starlight application set and records only packages
that were absent beforehand. It removes Epiphany, Chromium and all installed
LibreOffice components, recording them for rollback, then installs the official
WPS Office 12 RPM. --user also assigns the Starlight avatar to that local user.
It never removes user data.
EOF
}

while (($#)); do
    case "$1" in
        --skip-flatpaks) skip_flatpaks=true ;;
        --user)
            shift
            (($#)) || { echo 'Missing local user after --user.' >&2; exit 2; }
            profile_user="$1"
            ;;
        -h|--help) usage; exit 0 ;;
        *) echo "Unknown option: $1" >&2; usage >&2; exit 2 ;;
    esac
    shift
done

[[ ${EUID} -eq 0 ]] || { echo 'Run as root: sudo starlight-fedora-apply' >&2; exit 1; }
command -v dnf >/dev/null || { echo 'This helper requires Fedora dnf.' >&2; exit 1; }
install -d -m 0755 "${state_dir}"
touch "${installed_file}" "${removed_file}" "${flatpak_file}"

# Fedora base/RPM Fusion-independent mappings of the Starlight package lists.
packages=(
  firefox thunderbird gnome-tweaks gnome-extensions-app ptyxis gnome-terminal
  gnome-software flatpak flatseal fwupd gnome-firmware
  pipewire wireplumber pipewire-utils pavucontrol helvum bluez
  gstreamer1-plugins-base gstreamer1-plugins-good gstreamer1-plugins-bad-free
  gstreamer1-plugin-libav ffmpeg-free vlc mpv gimp
  avahi cifs-utils samba-client exfatprogs ntfs-3g libmtp mtp-tools 7zip
  git curl wget file procps-ng zip unzip vim-enhanced htop python3-pip
  python3-virtualenv nodejs npm podman qemu-kvm qemu-img libvirt-client
  virt-manager bridge-utils bash-completion fzf fd-find bat eza yq tmux
  direnv ShellCheck shfmt starship jetbrains-mono-fonts-all fira-code-fonts google-noto-emoji-fonts
  gamemode mangohud vulkan-tools mesa-dri-drivers mesa-vulkan-drivers
  steam
  incus incus-client incus-tools lxcfs dnsmasq btrfs-progs lvm2
  gnome-shell-extension-dash-to-dock gnome-shell-extension-appindicator
  gnome-shell-extension-caffeine gnome-shell-extension-tiling-assistant
  gnome-shell-extension-blur-my-shell ddcutil i2c-tools
)

available=()
for package in "${packages[@]}"; do
    if dnf -q repoquery --available --qf '%{name}' "${package}" 2>/dev/null | grep -Fxq "${package}"; then
        available+=("${package}")
    else
        echo "Skipped unavailable Fedora package: ${package}" >&2
    fi
done

to_install=()
for package in "${available[@]}"; do
    rpm -q "${package}" >/dev/null 2>&1 || to_install+=("${package}")
done
if ((${#to_install[@]})); then
    dnf install -y "${to_install[@]}"
    printf '%s\n' "${to_install[@]}" >>"${installed_file}"
    sort -u -o "${installed_file}" "${installed_file}"
fi

wps_was_installed=false
if rpm -q wps-office >/dev/null 2>&1; then
    wps_was_installed=true
fi

if ! rpm -q --qf '%{VERSION}\n' wps-office 2>/dev/null | grep -Fxq "${wps_version}"; then
    [[ "$(rpm -E '%{_arch}')" == x86_64 ]] || {
        echo 'WPS Office 12 is currently pinned only for Fedora x86_64.' >&2
        exit 1
    }

    wps_stage="$(mktemp -d)"
    trap 'rm -rf "${wps_stage}"' EXIT
    wps_rpm="${wps_stage}/${wps_rpm_name}"
    wps_timestamp="$(date +%s)"
    wps_signature="$(
        printf '%s' "${wps_download_key}${wps_rpm_path}${wps_timestamp}" |
            md5sum |
            cut -d' ' -f1
    )"
    wps_url="https://wps-linux-personal.wpscdn.cn${wps_rpm_path}?t=${wps_timestamp}&k=${wps_signature}"

    curl -fL --retry 3 --retry-delay 2 "${wps_url}" -o "${wps_rpm}"
    printf '%s  %s\n' "${wps_rpm_sha256}" "${wps_rpm}" | sha256sum -c -
    dnf install -y "${wps_rpm}"
    rm -rf "${wps_stage}"
    trap - EXIT
fi

if ! ${wps_was_installed}; then
    printf '%s\n' wps-office >>"${installed_file}"
    sort -u -o "${installed_file}" "${installed_file}"
fi

conflict_packages=(epiphany chromium)
mapfile -t libreoffice_packages < <(rpm -qa --qf '%{NAME}\n' 'libreoffice*' | sort -u)
conflict_packages+=("${libreoffice_packages[@]}")
installed_conflicts=()
for package in "${conflict_packages[@]}"; do
    if rpm -q "${package}" >/dev/null 2>&1; then
        installed_conflicts+=("${package}")
    fi
done
if ((${#installed_conflicts[@]})); then
    dnf remove -y "${installed_conflicts[@]}"
    printf '%s\n' "${installed_conflicts[@]}" >>"${removed_file}"
    sort -u -o "${removed_file}" "${removed_file}"
fi

if ! ${skip_flatpaks}; then
    flatpak remote-add --system --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
    for application in \
        com.rtosta.zapzap \
        io.github.kolunmi.Bazaar \
        org.telegram.desktop; do
        if ! flatpak info --system "${application}" >/dev/null 2>&1; then
            flatpak install --system --noninteractive flathub "${application}"
            printf '%s\n' "${application}" >>"${flatpak_file}"
        fi
    done
    sort -u -o "${flatpak_file}" "${flatpak_file}"
fi

if [[ -n "${profile_user}" ]]; then
    id "${profile_user}" >/dev/null 2>&1 || {
        echo "Unknown local user: ${profile_user}" >&2
        exit 2
    }

    avatar_state_dir="${state_dir}/avatar"
    avatar_saved_user="${avatar_state_dir}/user"
    install -d -m 0700 "${avatar_state_dir}"
    if [[ -s "${avatar_saved_user}" ]] && \
        [[ "$(<"${avatar_saved_user}")" != "${profile_user}" ]]; then
        echo 'An avatar from another user is already recorded for rollback.' >&2
        exit 1
    fi

    if [[ ! -f "${avatar_state_dir}/saved" ]]; then
        printf '%s\n' "${profile_user}" >"${avatar_saved_user}"
        avatar_user_file="/var/lib/AccountsService/users/${profile_user}"
        avatar_icon_file="/var/lib/AccountsService/icons/${profile_user}"
        if [[ -f "${avatar_user_file}" ]]; then
            touch "${avatar_state_dir}/user-file-existed"
            grep '^Icon=' "${avatar_user_file}" | tail -n 1 \
                >"${avatar_state_dir}/previous-icon-line" || true
        fi
        if [[ -f "${avatar_icon_file}" ]]; then
            touch "${avatar_state_dir}/icon-file-existed"
            install -m 0600 "${avatar_icon_file}" \
                "${avatar_state_dir}/previous-icon"
        fi
        touch "${avatar_state_dir}/saved"
    fi

    starlight-fedora-set-user-avatar "${profile_user}"
fi

printf '%s\n' "${profile_version}" >"${profile_marker}"
echo 'Starlight Fedora profile applied. Log out and back in for GNOME defaults.'
echo 'Rollback: sudo starlight-fedora-rollback'
